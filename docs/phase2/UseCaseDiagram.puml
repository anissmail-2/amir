@startuml SUFMS_UseCase_Diagram
title Smart Urban Farming Management System - Use Case Diagram

' Actors
actor "Urban Farmer" as Farmer #lightblue
actor "Home Gardener" as Gardener #lightgreen
actor "Agricultural Consultant" as Consultant #lightyellow
actor "Consumer/Buyer" as Consumer #lightpink
actor "Restaurant Owner" as Restaurant #lightcoral
actor "System Administrator" as Admin #lightgray

' External Systems
actor "IoT Sensor" as Sensor <<External System>> #technology
actor "Weather API" as Weather <<External System>> #technology
actor "Payment Gateway" as Payment <<External System>> #technology
actor "AI/ML Service" as AI <<External System>> #technology

rectangle "Smart Urban Farming Management System" {

  ' User Management Package
  package "User Management" {
    usecase "Register Account" as UC001
    usecase "Login" as UC002
    usecase "Manage Profile" as UC003
    usecase "Reset Password" as UC004
  }

  ' Farm Management Package
  package "Farm Management" {
    usecase "Create Farm" as UC005
    usecase "Manage Crops" as UC006
    usecase "Plan Crop Rotation" as UC007
    usecase "Schedule Tasks" as UC008
  }

  ' Monitoring Package
  package "Monitoring & Sensors" {
    usecase "Register Sensor" as UC009
    usecase "View Real-Time Data" as UC010
    usecase "View Historical Data" as UC011
    usecase "Configure Alerts" as UC012
    usecase "Receive Notifications" as UC013
  }

  ' AI Features Package
  package "AI-Powered Features" {
    usecase "Get Crop Recommendations" as UC014
    usecase "Detect Pest/Disease" as UC015
    usecase "Generate Irrigation Schedule" as UC016
    usecase "Predict Yield" as UC017
    usecase "Chat with AI Assistant" as UC018
  }

  ' Resource Management Package
  package "Resource Management" {
    usecase "Track Water Usage" as UC019
    usecase "Log Fertilizer Application" as UC020
    usecase "Track Expenses" as UC021
  }

  ' Marketplace Package
  package "Marketplace" {
    usecase "List Product" as UC022
    usecase "Search Products" as UC023
    usecase "Purchase Product" as UC024
    usecase "Process Payment" as UC025
    usecase "Manage Orders" as UC026
    usecase "Rate/Review" as UC027
  }

  ' Analytics Package
  package "Analytics & Reporting" {
    usecase "View Farm Dashboard" as UC028
    usecase "Generate Reports" as UC029
    usecase "View Sustainability Metrics" as UC030
  }

  ' Community Package
  package "Knowledge Hub" {
    usecase "Browse Educational Content" as UC031
    usecase "Participate in Forum" as UC032
  }

  ' Administration Package
  package "System Administration" {
    usecase "Manage Users" as UC033
    usecase "Moderate Content" as UC034
    usecase "Monitor System Health" as UC035
  }
}

